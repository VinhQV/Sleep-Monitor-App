# Copy to .env. Never put provider keys into the Android app or a ZIP.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
# OpenAI: AI_PROVIDER=openai, AI_MODEL=<model enabled in your account>, OPENAI_API_KEY=<local key>
# Ollama: AI_PROVIDER=ollama, AI_MODEL=<installed model name>. Start Ollama separately.
# Gemini cloud: run Configure-Cloud-AI.cmd. The app can include a seven-day summary when personalization is enabled.
